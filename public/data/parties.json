      },
      {
        "party": "Linke",
        "stance": "pro",
        "quote": "vielleicht könne die Aktion aber nun einfach öfter angeboten werden.",
        "sessionId": "2025-06-23"
      },
      {
        "party": "Grüne",
        "stance": "pro",
        "quote": "letztendlich werde ein Mix aus verschiedenen Angeboten benötigt",
        "sessionId": "2025-06-23"
      },
      {
        "party": "AfD",
        "stance": "neutral",
        "quote": "warum nur 9 von 12 Bezirken am Aktionstag teilgenommen hätten.",
