      {
        "party": "Grüne",
        "stance": "neutral",
        "quote": "Sei hier eine Nachschiebeliste vom Senat geplant, um hier noch einmal nachzuarbeiten?",
        "sessionId": "2025-09-08"
      }
    ]
  },
  {
    "topicId": "t_57894898",
    "positions": [
      {
        "party": "Grüne",
        "stance": "pro",
        "quote": "Warum habe der Senat nicht schon jetzt das umgesetzt, was er selbst für sinnvoll halte?",
        "sessionId": "2025-09-08"
      },
      {
        "party": "SPD",
        "stance": "pro",
        "quote": "Welche Vorteile werden vom Senat/der CDO gesehen, den ... Einzelplan 25 zu einem Digitalhaushalt weiterzuentwickeln...",
        "sessionId": "2025-09-08"
      }
    ]
  },
  {
    "topicId": "t_21924172",
    "positions": [
      {
        "party": "Linke",
        "stance": "neutral",
        "quote": "...wolle er um eine schriftliche Beantwortung der Frage 27 b bitten.",
        "sessionId": "2025-09-08"
      }
    ]
  },
  {
    "topicId": "t_22813333",
    "positions": [
      {
        "party": "Linke",
        "stance": "contra",
        "quote": "Nehme das Land Berlin sehenden Auges in Kauf, dass ... Kollegen mit veralteten ... Geräten arbeiten müssten?",
