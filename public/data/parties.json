    "positions": [
      {
        "party": "CDU",
        "stance": "pro",
        "quote": "Die Sicherheitskräfte bräuchten das richtige Handwerkszeug...",
        "sessionId": "2025-10-06"
      },
      {
        "party": "SPD",
        "stance": "pro",
        "quote": "...wichtig, um die Polizei zur unmittelbaren Handlung zu befähigen.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "Grüne",
        "stance": "contra",
        "quote": "Der Rechtsstaat müsse Grundrechte schützen und nicht Gesetzesgrundlagen so weit ausgestalten...",
        "sessionId": "2025-10-06"
      },
      {
        "party": "Linke",
        "stance": "contra",
        "quote": "...auch ihre Fraktion teile die Begeisterung für eines der repressivsten Polizeigesetze nicht.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "AfD",
        "stance": "pro",
        "quote": null,
        "sessionId": "2025-10-06"
      }
    ]
  },
  {
    "topicId": "t_85301880",
    "positions": [
      {
        "party": "CDU",
        "stance": "pro",
        "quote": "Trotz der Einsparungen sei es gelungen, die großen und tragenden Vorhaben zu sichern.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "SPD",
        "stance": "pro",
        "quote": "Im letzten Nachtragshaushalt...sei so gespart worden, dass nun für Stabilität...Platz sei.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "Grüne",
        "stance": "contra",
        "quote": "Das Problem sei, dass dieser Weg mit dem nun aufgestellten Haushalt verlassen werde.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "Linke",
        "stance": "contra",
        "quote": "Es sei so keine vorwärts gerichtete Digitalisierungsstrategie erkennbar.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "AfD",
        "stance": "contra",
        "quote": "...Zurückhaltung zu erkennen und ein Entwurf vorgelegt worden sei, der keine unnötigen Extras enthalte.",
        "sessionId": "2025-10-06"
      }
    ]
  },
  {
    "topicId": "t_56971937",
    "positions": [
      {
        "party": "Grüne",
        "stance": "contra",
        "quote": "Für jedes Fachverfahren werde also das Vierfache dessen ausgegeben, was nötig wäre...",
        "sessionId": "2025-10-06"
      },
      {
        "party": "Linke",
        "stance": "contra",
        "quote": "Mit einer veralteten IT-Infrastruktur könne keine IT-Sicherheit gewährleistet werden.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "AfD",
        "stance": "neutral",
        "quote": "...Fokus...nicht auf Transformation um jeden Preis liegen, sondern auf der Resilienz.",
        "sessionId": "2025-10-06"
      }
    ]
  },
