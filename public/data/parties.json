      },
      {
        "party": "SPD",
        "stance": "pro",
        "quote": "...es bleibe zu hoffen, dass das Projekt nun bald fertiggestellt werden könne.",
        "sessionId": "2025-05-19"
      },
      {
        "party": "Linke",
        "stance": "neutral",
        "quote": "Wie solle mit diesem Widerspruch [Digital-Only vs. analoger Zugang] umgegangen werden?",
