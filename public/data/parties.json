    "positions": [
      {
        "party": "Grüne",
        "stance": "neutral",
        "quote": "Trifft es zu, dass sich die Windows 11-Umstellung auch dadurch verzögert...",
        "sessionId": "2025-07-07"
      },
      {
        "party": "Linke",
        "stance": "neutral",
        "quote": "...welche Behörden zum ... Verbot der Nutzung von Windows 10 noch nicht ... umgestellt hätten.",
        "sessionId": "2025-07-07"
      }
    ]
  },
  {
    "topicId": "t_11948015",
    "positions": [
      {
        "party": "CDU",
        "stance": "pro",
        "quote": "Die Umstellung sei sehr erfolgreich verlaufen; nun solle über die gesammelten Erfahrungen berichtet werden.",
        "sessionId": "2025-07-07"
      },
      {
        "party": "SPD",
        "stance": "pro",
        "quote": "...dass der Rechnungshof mit seiner Entscheidung – richtigerweise – auf das Privileg verzichtet...",
        "sessionId": "2025-07-07"
      },
      {
        "party": "Grüne",
        "stance": "neutral",
        "quote": "...ob nur der BerlinPC in Anspruch genommen werde oder ob auch die anderen Angebote ... genutzt werden sollten.",
        "sessionId": "2025-07-07"
      },
      {
        "party": "Linke",
        "stance": "neutral",
        "quote": "Erhoffe sich der Rechnungshof durch die Standardisierung ... perspektivisch Haushaltseinsparungen?",
        "sessionId": "2025-07-07"
      }
    ]
  },
  {
    "topicId": "t_33986582",
    "positions": [
      {
        "party": "Grüne",
        "stance": "pro",
        "quote": "...dass die IT-Standardisierung ... nur dann wirklich positive Effekte haben könne...",
        "sessionId": "2025-07-07"
      },
      {
        "party": "Linke",
        "stance": "neutral",
        "quote": "...wo die baulichen Standards ... eingesehen werden könnten.",
        "sessionId": "2025-07-07"
      }
    ]
  },
  {
    "topicId": "t_25688683",
    "positions": [
      {
        "party": "Grüne",
        "stance": "pro",
        "quote": "Was sind Berlins Ideen und Strategien um die digitale Souveränität seiner Verwaltung zu sichern?",
        "sessionId": "2025-06-23"
      }
    ]
  },
  {
    "topicId": "t_62217014",
    "positions": [
      {
        "party": "Grüne",
        "stance": "contra",
        "quote": "die Ausführungen erschienen ihm angesichts des Vorfalls und des Kontrolldefizits nicht ausreichend.",
        "sessionId": "2025-06-23"
      },
      {
        "party": "Linke",
        "stance": "contra",
        "quote": "Könne die Verarbeitung intern geschehen, etwa durch eine Nutzung der Kapazitäten des ITDZ?",
        "sessionId": "2025-06-23"
      },
      {
        "party": "SPD",
        "stance": "neutral",
        "quote": "Habe es hier eine Rückfrage der Datenschutzbeauftragten gegeben? Welcher Art sei der Austausch?",
        "sessionId": "2025-06-23"
      },
      {
        "party": "CDU",
        "stance": "neutral",
        "quote": "Könnten hier konkretere Angaben darüber gemacht werden, was geplant sei, um das Risiko... zu minimieren?",
        "sessionId": "2025-06-23"
      },
      {
        "party": "Linke",
        "stance": "contra",
        "quote": "Die BVG habe hier zu spät und zu zaghaft gehandelt.",
        "sessionId": "2025-05-19"
      },
      {
        "party": "CDU",
        "stance": "contra",
        "quote": "Eine große Transparenz sei in dem beschriebenen Vorgehen ... nicht zu erkennen.",
        "sessionId": "2025-05-19"
      },
      {
        "party": "Grüne",
        "stance": "contra",
        "quote": "Die BVG unterstütze mit ihrer Krisenkommunikation also potenziell den Angriff.",
        "sessionId": "2025-05-19"
      },
      {
        "party": "SPD",
        "stance": "pro",
        "quote": "...Umgang der BVG mit den Vorfällen bisher als gut und nicht sehr beunruhigend.",
        "sessionId": "2025-05-19"
      },
      {
        "party": "AfD",
        "stance": "neutral",
        "quote": "Gehe die BVG ... davon aus, dass dieser Fall hier zutreffen könnte?",
        "sessionId": "2025-05-19"
      }
    ]
  },
  {
    "topicId": "t_40415971",
    "positions": [
      {
        "party": "Grüne",
        "stance": "pro",
        "quote": "Open Data ein zentrales Thema in einer modernen Verwaltung sei, um nächste Schritte... machen zu können.",
        "sessionId": "2025-06-23"
      },
      {
        "party": "SPD",
        "stance": "pro",
        "quote": "dass man in bestimmten Bereichen wie etwa der Gesundheitsforschung auf Datenspenden angewiesen sei.",
        "sessionId": "2025-06-23"
      },
      {
        "party": "Linke",
        "stance": "pro",
        "quote": "ob eine gesetzliche Grundlage im Digitalgesetz vorstellbar sei: Durch eine solche gesetzliche Verpflichtung",
        "sessionId": "2025-06-23"
      }
    ]
  },
