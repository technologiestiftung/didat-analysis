  },
  {
    "topicId": "t_81247818",
    "positions": [
      {
        "party": "CDU",
        "stance": "pro",
        "quote": "Trotz der Einsparungen sei es gelungen, die großen und tragenden Vorhaben zu sichern.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "SPD",
        "stance": "pro",
        "quote": "Im letzten Nachtragshaushalt ... sei so gespart worden, dass nun ... Platz sei.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "Grüne",
        "stance": "contra",
        "quote": "...dass dieser Weg mit dem nun aufgestellten Haushalt verlassen werde.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "Linke",
        "stance": "contra",
        "quote": "Es sei so keine vorwärts gerichtete Digitalisierungsstrategie erkennbar.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "AfD",
        "stance": "contra",
        "quote": "...Zurückhaltung zu erkennen und ein Entwurf ... der keine unnötigen Extras enthalte.",
        "sessionId": "2025-10-06"
      }
    ]
  },
  {
    "topicId": "t_48677970",
    "positions": [
      {
        "party": "Grüne",
        "stance": "contra",
        "quote": "Das Fehlen einer gesamtstädtischen Steuerung werde in vielen Berichten betont...",
        "sessionId": "2025-10-06"
      },
      {
        "party": "CDU",
        "stance": "pro",
        "quote": "Auch die IKT-Basisdienste blieben uneingeschränkt gewährleistet...",
        "sessionId": "2025-10-06"
      },
      {
        "party": "Linke",
        "stance": "contra",
        "quote": "Mit einer veralteten IT-Infrastruktur könne keine IT-Sicherheit gewährleistet werden.",
        "sessionId": "2025-10-06"
      },
      {
        "party": "AfD",
        "stance": "neutral",
        "quote": "...Fokus ... nicht auf Transformation um jeden Preis liegen, sondern auf der Resilienz.",
        "sessionId": "2025-10-06"
      }
    ]
  },
