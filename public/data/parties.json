  {
    "topicId": "t_48891645",
    "positions": [
      {
        "party": "Grüne",
        "stance": "contra",
        "quote": "Die Verwaltungsreform [wird] nicht speziell für den Bereich Digitalisierung durchgeführt.",
        "sessionId": "2025-05-19"
      },
      {
        "party": "AfD",
        "stance": "neutral",
        "quote": "...die zu erwartenden Veränderungen für die Praxis seien jedoch überschaubar.",
