      {
        "party": "SPD",
        "stance": "neutral",
        "quote": "ob die Zusammenfassung der IKT-Titel in einem Haushaltsplan auch negative Auswirkungen haben könne.",
        "sessionId": "2025-04-07"
      }
    ]
  },
  {
